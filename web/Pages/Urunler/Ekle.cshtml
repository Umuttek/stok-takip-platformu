@page
@model StokTakip.Pages.Urunler.EkleModel
@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="Index">Ürünler</a></li>
                <li class="breadcrumb-item active">Yeni Ürün Ekle</li>
            </ol>
        </nav>

        <div class="card shadow-sm border-0">
            <div class="card-body p-3 p-md-4">
                <div class="mb-3">
                    <h3 class="card-title h4 fw-bold mb-1">Yeni Ürün Ekle</h3>
                    <p class="text-muted small mb-0">
                        Ürün barkodu (EAN-13) sistem tarafından otomatik üretilir ve başlangıç stoğu seçilen depoya zimmetlenir.
                    </p>
                </div>

                <form method="post" id="urunForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <partial name="_UrunForm" for="Urun" />
                    <div class="d-flex flex-column flex-sm-row gap-2 mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary fw-semibold flex-grow-1 py-2">
                            Ürünü Ekle ve Depoya Zimmetle
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary py-2">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Hızlı Kategori Ekle Modal -->
<div class="modal fade" id="hizliKategoriModal" tabindex="-1" aria-labelledby="hizliKategoriModalBaslik" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="hizliKategoriModalBaslik">Yeni Kategori Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div id="hizliKategoriHata" class="alert alert-danger py-2 small d-none"></div>
                <div class="mb-3">
                    <label for="yeniKategoriAd" class="form-label fw-semibold">Kategori Adı <span class="text-danger">*</span></label>
                    <input type="text" id="yeniKategoriAd" class="form-control" placeholder="Örn: Elektronik" />
                </div>
                <div class="mb-0">
                    <label for="yeniKategoriAciklama" class="form-label fw-semibold">Açıklama</label>
                    <input type="text" id="yeniKategoriAciklama" class="form-control" placeholder="İsteğe bağlı açıklama" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary fw-semibold" id="hizliKategoriKaydetBtn">Kategori Ekle</button>
            </div>
        </div>
    </div>
</div>

<!-- Hızlı Depo Ekle Modal -->
<div class="modal fade" id="hizliDepoModal" tabindex="-1" aria-labelledby="hizliDepoModalBaslik" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="hizliDepoModalBaslik">Yeni Depo Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div id="hizliDepoHata" class="alert alert-danger py-2 small d-none"></div>
                <div class="mb-3">
                    <label for="yeniDepoAd" class="form-label fw-semibold">Depo Adı <span class="text-danger">*</span></label>
                    <input type="text" id="yeniDepoAd" class="form-control" placeholder="Örn: Merkez Depo" />
                </div>
                <div class="mb-0">
                    <label for="yeniDepoKonum" class="form-label fw-semibold">Konum</label>
                    <input type="text" id="yeniDepoKonum" class="form-control" placeholder="Örn: İstanbul / Tuzla, A Blok" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary fw-semibold" id="hizliDepoKaydetBtn">Depo Ekle</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_UrunFormScriptsPartial" />
}
