@model StokTakip.Models.Urun
@using Microsoft.AspNetCore.Mvc.Rendering
@* Sayfadan <partial name="_UrunForm" for="Urun" /> ile çağrılır. Kategori listesi ViewData["KategoriListesi"] ile gelir. *@
<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="UrunKodu" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="UrunKodu" class="form-control text-uppercase" placeholder="ör. URN-001" autofocus />
        <span asp-validation-for="UrunKodu" class="text-danger small"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Ad" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="Ad" class="form-control" />
        <span asp-validation-for="Ad" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="KategoriId" class="form-label"></label> <span class="text-danger">*</span>
        <select asp-for="KategoriId" asp-items="@((IEnumerable<SelectListItem>?)ViewData["KategoriListesi"] ?? Enumerable.Empty<SelectListItem>())" class="form-select">
            <option value="0">-- Kategori seçin --</option>
        </select>
        <span asp-validation-for="KategoriId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MevcutMiktar" class="form-label"></label>
        <input asp-for="MevcutMiktar" type="number" min="0" class="form-control" />
        <span asp-validation-for="MevcutMiktar" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="KritikStokSeviyesi" class="form-label"></label>
        <input asp-for="KritikStokSeviyesi" type="number" min="0" class="form-control" />
        <div class="form-text">Mevcut miktar bu değere eşit veya altına düşünce ürün "kritik" sayılır.</div>
        <span asp-validation-for="KritikStokSeviyesi" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Aciklama" class="form-label"></label>
        <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Aciklama" class="text-danger small"></span>
    </div>
</div>
