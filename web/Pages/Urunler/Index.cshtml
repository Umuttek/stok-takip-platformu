@page
@model StokTakip.Pages.Urunler.IndexModel
@{
    ViewData["Title"] = "Ürünler";
    var yonetici = User.IsInRole("Yonetici");
    var filtreVar = !string.IsNullOrEmpty(Model.Arama) || Model.KategoriId.HasValue || Model.SadeceKritik;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-0">Ürünler</h2>
        <small class="text-muted">
            @Model.Urunler.Count ürün listeleniyor
            @if (Model.KritikSayisi > 0)
            {
                <span>· <a asp-page="Index" asp-route-sadeceKritik="true" class="text-danger">@Model.KritikSayisi ürün kritik stokta</a></span>
            }
        </small>
    </div>
    @if (yonetici)
    {
        <a asp-page="Ekle" class="btn btn-primary">+ Yeni Ürün</a>
    }
</div>

<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="search" name="arama" value="@Model.Arama" class="form-control" placeholder="Ürün adı veya kodu ile ara..." />
        </div>
        <div class="col-md-3">
            <select name="kategoriId" asp-items="Model.KategoriListesi" class="form-select">
                <option value="">Tüm kategoriler</option>
            </select>
        </div>
        <div class="col-md-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="sadeceKritik" value="true" id="sadeceKritik" @(Model.SadeceKritik ? "checked" : "") />
                <label class="form-check-label" for="sadeceKritik">Sadece kritik</label>
            </div>
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-outline-secondary flex-grow-1">Filtrele</button>
            @if (filtreVar)
            {
                <a asp-page="Index" class="btn btn-link px-2" title="Filtreleri temizle">✕</a>
            }
        </div>
    </div>
</form>

@if (Model.Urunler.Count == 0)
{
    <div class="alert alert-light border">
        @(filtreVar ? "Filtrelerle eşleşen ürün bulunamadı." : "Henüz ürün eklenmemiş.")
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Kod</th>
                        <th>Ürün Adı</th>
                        <th>Kategori</th>
                        <th class="text-end">Mevcut</th>
                        <th class="text-end">Kritik Seviye</th>
                        <th class="text-center">Durum</th>
                        @if (yonetici) { <th class="text-end">İşlemler</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Urunler)
                    {
                        <tr class="@(u.KritikMi ? "table-danger" : "")">
                            <td><code>@u.UrunKodu</code></td>
                            <td>
                                <div class="fw-semibold">@u.Ad</div>
                                @if (!string.IsNullOrWhiteSpace(u.Aciklama))
                                {
                                    <small class="text-muted">@u.Aciklama</small>
                                }
                            </td>
                            <td>@u.Kategori?.Ad</td>
                            <td class="text-end fw-semibold">@u.MevcutMiktar</td>
                            <td class="text-end text-muted">@u.KritikStokSeviyesi</td>
                            <td class="text-center">
                                @if (u.KritikMi)
                                {
                                    <span class="badge text-bg-danger">Kritik</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Yeterli</span>
                                }
                            </td>
                            @if (yonetici)
                            {
                                <td class="text-end text-nowrap">
                                    <a asp-page="Duzenle" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                    <a asp-page="Sil" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
