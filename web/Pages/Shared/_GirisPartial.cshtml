@using Microsoft.AspNetCore.Identity
@using StokTakip.Models
@inject SignInManager<Kullanici> SignInManager
<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-dark">Merhaba, @User.Identity?.Name</span>
        </li>
        <li class="nav-item">
            <form method="post" action="/Hesap/Cikis">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-link btn btn-link text-dark">Çıkış</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Hesap/Giris">Giriş</a></li>
        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Hesap/Kayit">Kayıt Ol</a></li>
    }
</ul>