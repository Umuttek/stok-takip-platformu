@page
@model IndexModel
@{
    ViewData["Title"] = "Ana Sayfa";
    var girisYapildi = User.Identity?.IsAuthenticated == true;
    var yonetici = User.IsInRole("Yonetici");
}

<div class="p-4 mb-4 rounded-3 bg-primary bg-gradient text-white shadow-sm">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1">
                @if (girisYapildi)
                {
                    <span>Hoş geldiniz, @Model.KullaniciAdSoyad</span>
                }
                else
                {
                    <span>Stok Takip Platformu</span>
                }
            </h1>
            <p class="mb-0 opacity-75">
                Ürün, kategori ve depo stok durumlarını merkezi olarak takip edin.
            </p>
        </div>
        @if (girisYapildi)
        {
            <span class="badge bg-light text-primary fs-6 px-3 py-2">
                @(yonetici ? "Yönetici" : "Çalışan")
            </span>
        }
        else
        {
            <div class="d-flex gap-2">
                <a asp-page="/Hesap/Giris" class="btn btn-light fw-semibold">Giriş Yap</a>
                <a asp-page="/Hesap/Kayit" class="btn btn-outline-light">Kayıt Ol</a>
            </div>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100 border-0 border-start border-primary border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Toplam Ürün Çeşidi</div>
                <div class="display-6 fw-bold text-primary my-1">@Model.UrunCesidiSayisi</div>
                <small class="text-muted">@Model.KategoriSayisi farklı kategoride</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100 border-0 border-start border-success border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Tüm Ürünlerin Toplam Adeti</div>
                <div class="display-6 fw-bold text-success my-1">@Model.ToplamUrunAdeti</div>
                <small class="text-muted">Stoktaki toplam birim sayısı</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100 border-0 border-start border-info border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Depo Sayısı</div>
                <div class="display-6 fw-bold text-info my-1">@Model.DepoSayisi</div>
                <small class="text-muted">Kayıtlı aktif depo</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100 border-0 border-start @(Model.KritikStokUrunSayisi > 0 ? "border-danger" : "border-secondary") border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Kritik Stoğa Sahip Ürün</div>
                <div class="display-6 fw-bold @(Model.KritikStokUrunSayisi > 0 ? "text-danger" : "text-secondary") my-1">
                    @Model.KritikStokUrunSayisi
                </div>
                @if (Model.KritikStokUrunSayisi > 0)
                {
                    <a asp-page="/Urunler/Index" asp-route-sadeceKritik="true" class="small text-danger text-decoration-none fw-semibold">
                        Kritik ürünleri görüntüle →
                    </a>
                }
                else
                {
                    <small class="text-muted">Kritik seviyede ürün yok</small>
                }
            </div>
        </div>
    </div>
</div>

@if (girisYapildi)
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title">Ürün Yönetimi</h5>
                        <p class="card-text text-muted small">Ürünleri listele, ara, stok ve kritik stok seviyelerini takip et.</p>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <a asp-page="/Urunler/Index" class="btn btn-sm btn-outline-primary">Ürünleri Gör</a>
                        @if (yonetici)
                        {
                            <a asp-page="/Urunler/Ekle" class="btn btn-sm btn-primary">+ Yeni Ürün</a>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title">Kategori Yönetimi</h5>
                        <p class="card-text text-muted small">Ürün kategorilerini görüntüle ve düzenle.</p>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <a asp-page="/Kategoriler/Index" class="btn btn-sm btn-outline-primary">Kategorileri Gör</a>
                        @if (yonetici)
                        {
                            <a asp-page="/Kategoriler/Ekle" class="btn btn-sm btn-primary">+ Yeni Kategori</a>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title">Depo Yönetimi</h5>
                        <p class="card-text text-muted small">Depoları, konumlarını ve açıklamalarını yönet.</p>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <a asp-page="/Depolar/Index" class="btn btn-sm btn-outline-primary">Depoları Gör</a>
                        @if (yonetici)
                        {
                            <a asp-page="/Depolar/Ekle" class="btn btn-sm btn-primary">+ Yeni Depo</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.KritikUrunler.Count > 0)
    {
        <div class="card shadow-sm border-danger-subtle">
            <div class="card-header bg-danger-subtle text-danger-emphasis d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Kritik Stok Uyarısı</span>
                <a asp-page="/Urunler/Index" asp-route-sadeceKritik="true" class="btn btn-sm btn-outline-danger">Tümünü Gör</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Kod</th>
                            <th>Ürün Adı</th>
                            <th>Kategori</th>
                            <th class="text-end">Mevcut</th>
                            <th class="text-end">Kritik Seviye</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.KritikUrunler)
                        {
                            <tr>
                                <td><code>@u.UrunKodu</code></td>
                                <td class="fw-semibold">@u.Ad</td>
                                <td>@u.Kategori?.Ad</td>
                                <td class="text-end text-danger fw-bold">@u.MevcutMiktar</td>
                                <td class="text-end text-muted">@u.KritikStokSeviyesi</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
