@page
@model StokTakip.Pages.Depolar.IndexModel
@{
    ViewData["Title"] = "Depolar";
    var yonetici = User.IsInRole("Yonetici");
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-0">Depolar</h2>
        <small class="text-muted">Toplam @Model.Depolar.Count depo</small>
    </div>
    @if (yonetici)
    {
        <a asp-page="Ekle" class="btn btn-primary">+ Yeni Depo</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input type="search" name="arama" value="@Model.Arama" class="form-control" placeholder="Depo adı veya konuma göre ara..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
        @if (!string.IsNullOrEmpty(Model.Arama))
        {
            <a asp-page="Index" class="btn btn-link">Temizle</a>
        }
    </div>
</form>

@if (Model.Depolar.Count == 0)
{
    <div class="alert alert-light border">
        @(string.IsNullOrEmpty(Model.Arama) ? "Henüz depo eklenmemiş." : "Aramanızla eşleşen depo bulunamadı.")
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Depo Adı</th>
                        <th>Konum</th>
                        <th>Açıklama</th>
                        <th class="text-center">Stok Hareketi</th>
                        @if (yonetici) { <th class="text-end">İşlemler</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Depolar)
                    {
                        <tr>
                            <td class="fw-semibold">@d.Ad</td>
                            <td>@(string.IsNullOrWhiteSpace(d.Konum) ? "-" : d.Konum)</td>
                            <td class="text-muted">@(string.IsNullOrWhiteSpace(d.Aciklama) ? "-" : d.Aciklama)</td>
                            <td class="text-center"><span class="badge rounded-pill text-bg-secondary">@d.HareketSayisi</span></td>
                            @if (yonetici)
                            {
                                <td class="text-end text-nowrap">
                                    <a asp-page="Duzenle" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                    <a asp-page="Sil" asp-route-id="@d.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

