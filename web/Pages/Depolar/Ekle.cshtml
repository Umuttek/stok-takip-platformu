@page
@model StokTakip.Pages.Depolar.EkleModel
@{
    ViewData["Title"] = "Yeni Depo";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="Index">Depolar</a></li>
                <li class="breadcrumb-item active">Yeni Depo</li>
            </ol>
        </nav>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="card-title mb-4">Yeni Depo</h3>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <partial name="_DepoForm" for="Depo" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

