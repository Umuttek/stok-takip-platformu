@page
@model StokTakip.Pages.Hesap.KayitModel
@{
    ViewData["Title"] = "Kayıt Ol";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-3">Kayıt Ol</h2>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Girdi.AdSoyad" class="form-label"></label>
                <input asp-for="Girdi.AdSoyad" class="form-control" />
                <span asp-validation-for="Girdi.AdSoyad" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Girdi.Email" class="form-label"></label>
                <input asp-for="Girdi.Email" class="form-control" />
                <span asp-validation-for="Girdi.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Girdi.Sifre" class="form-label"></label>
                <input asp-for="Girdi.Sifre" class="form-control" />
                <span asp-validation-for="Girdi.Sifre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Girdi.SifreTekrar" class="form-label"></label>
                <input asp-for="Girdi.SifreTekrar" class="form-control" />
                <span asp-validation-for="Girdi.SifreTekrar" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-success w-100">Kayıt Ol</button>
        </form>
        <p class="mt-3">Zaten hesabın var mı? <a asp-page="/Hesap/Giris">Giriş yap</a></p>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}