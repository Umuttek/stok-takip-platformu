@page
@model StokTakip.Pages.Hesap.GirisModel
@{
    ViewData["Title"] = "Giriş Yap";
}
<div class="row justify-content-center py-3">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-3 p-md-4">
                <h2 class="h4 fw-bold mb-1">Giriş Yap</h2>
                <p class="text-muted small mb-4">Stok Takip hesabınızla oturum açın.</p>
                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <div class="mb-3">
                        <label asp-for="Girdi.Email" class="form-label fw-semibold"></label>
                        <input asp-for="Girdi.Email" class="form-control" placeholder="ornek@stoktakip.com" />
                        <span asp-validation-for="Girdi.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Girdi.Sifre" class="form-label fw-semibold"></label>
                        <input asp-for="Girdi.Sifre" class="form-control" />
                        <span asp-validation-for="Girdi.Sifre" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="Girdi.BeniHatirla" class="form-check-input" />
                        <label asp-for="Girdi.BeniHatirla" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">Giriş Yap</button>
                </form>
                <p class="mt-3 mb-0 text-center small">Hesabın yok mu? <a asp-page="/Hesap/Kayit">Kayıt ol</a></p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
