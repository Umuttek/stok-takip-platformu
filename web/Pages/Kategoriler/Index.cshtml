@page
@model StokTakip.Pages.Kategoriler.IndexModel
@{
    ViewData["Title"] = "Kategoriler";
    var yonetici = User.IsInRole("Yonetici");
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-0">Kategoriler</h2>
        <small class="text-muted">Toplam @Model.Kategoriler.Count kategori</small>
    </div>
    @if (yonetici)
    {
        <a asp-page="Ekle" class="btn btn-primary">+ Yeni Kategori</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input type="search" name="arama" value="@Model.Arama" class="form-control" placeholder="Kategori adına göre ara..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
        @if (!string.IsNullOrEmpty(Model.Arama))
        {
            <a asp-page="Index" class="btn btn-link">Temizle</a>
        }
    </div>
</form>

@if (Model.Kategoriler.Count == 0)
{
    <div class="alert alert-light border">
        @(string.IsNullOrEmpty(Model.Arama) ? "Henüz kategori eklenmemiş." : "Aramanızla eşleşen kategori bulunamadı.")
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Kategori Adı</th>
                        <th>Açıklama</th>
                        <th class="text-center">Ürün Sayısı</th>
                        @if (yonetici) { <th class="text-end">İşlemler</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.Kategoriler)
                    {
                        <tr>
                            <td class="fw-semibold">@k.Ad</td>
                            <td class="text-muted">@(string.IsNullOrWhiteSpace(k.Aciklama) ? "-" : k.Aciklama)</td>
                            <td class="text-center">
                                <a asp-page="/Urunler/Index" asp-route-kategoriId="@k.Id" class="badge rounded-pill text-bg-secondary text-decoration-none">@k.UrunSayisi</a>
                            </td>
                            @if (yonetici)
                            {
                                <td class="text-end text-nowrap">
                                    <a asp-page="Duzenle" asp-route-id="@k.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                    <a asp-page="Sil" asp-route-id="@k.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

